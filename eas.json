{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "release": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "nightly": {
      "extends": "release",
      "autoIncrement": true,
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6821412351"
      }
    }
  }
}
