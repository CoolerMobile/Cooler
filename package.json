{
  "name": "cooler",
  "main": "expo-router/entry",
  "private": true,
  "version": "1.3.4",
  "scripts": {
    "dev": "expo start -c --go",
    "dev:native-build": "bun run fix:licenses && expo run --device",
    "dev:native-rebuild": "bun run clean:native && expo run --device",
    "dev:native-build:eas": "eas build --profile development",
    "clean:native": "rm -rf .expo ios android",
    "clean": "rm -rf .expo node_modules && bun install",
    "fix:licenses": "bun scripts/licenses.ts",
    "eas-build-pre-install": "bash scripts/eas-preinstall.sh",
    "eas-build-post-install": "bun run fix:licenses",
    "release": "bun scripts/release.ts",
    "release:ios": "bun scripts/release.ts --ios --submit",
    "release:store": "bun scripts/release.ts --ios --submit --push-metadata",
    "release:eas": "bun scripts/release.ts --eas --ios --submit",
    "release:eas:store": "bun scripts/release.ts --eas --ios --submit --push-metadata",
    "release:nightly": "bun scripts/release.ts --ios --nightly",
    "release:bump": "bun scripts/release.ts --bump-only",
    "test": "bun test",
    "cloud:keys": "bun dev/coolercloud/keys.ts",
    "cloud:serve": "bun dev/coolercloud/server.ts",
    "cloud:emulate": "bun dev/coolercloud/emulate.ts"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/timeago.js": "^1.0.0",
    "@expo/ui": "~57.0.26",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "expo": "~57.0.32",
    "expo-background-task": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.5",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-modern-table": "^0.1.2",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.30",
    "expo-screen-capture": "~57.0.4",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.72.0",
    "nativewind": "^4.2.7",
    "normalize-url": "^9.0.1",
    "ofetch": "^1.5.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-legal": "^1.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-swipeable-actions": "^0.1.12",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "simple-icons": "^16.37.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "^57.0.17",
    "jose": "^6.2.17",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-screens": "4.27.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "patchedDependencies": {
    "expo-screen-capture@57.0.2": "patches/expo-screen-capture@57.0.2.patch",
    "expo-modern-table@0.1.2": "patches/expo-modern-table@0.1.2.patch",
    "react-native-swipeable-actions@0.1.12": "patches/react-native-swipeable-actions@0.1.12.patch"
  }
}
